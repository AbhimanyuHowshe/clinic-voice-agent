# Voice agent environment variables (server-side only)
# Fill in with: uv run python scripts/set_env.py   (never commit agent/.env)

# --- LiveKit ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- Sarvam AI (STT, TTS and LLM) ---
SARVAM_API_KEY=your-sarvam-api-key

# --- Supabase (server-side; the secret/service-role key must never reach a browser) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# --- Clinic used for rooms not created by the web app (e.g. the Agents Playground) ---
DEFAULT_CLINIC_SLUG=sanjeevani
