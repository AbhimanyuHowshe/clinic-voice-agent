# Voice agent environment variables (server-side only)
# Copy to agent/.env and fill in real values locally. Never commit agent/.env.
# Variable names are provisional until verified against the installed SDKs (Phase 0).

# --- LiveKit ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- Sarvam AI (STT, TTS, and LLM if used) ---
SARVAM_API_KEY=your-sarvam-api-key

# --- Supabase (server-side; the service-role key must never reach a browser) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Clinic defaults ---
CLINIC_TIMEZONE=Asia/Kolkata
