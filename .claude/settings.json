{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/credentials*.json)",
      "Read(**/service-account*.json)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Bash(cat *.env)",
      "Bash(cat *.env.local)",
      "Bash(cat *.env.production)",
      "Bash(type *.env)",
      "Bash(printenv*)",
      "Bash(env)",
      "PowerShell(Get-Content *.env)",
      "PowerShell(gc *.env)",
      "PowerShell(cat *.env)",
      "PowerShell(Get-ChildItem env:*)",
      "PowerShell(gci env:*)",
      "PowerShell(ls env:*)",
      "PowerShell(dir env:*)"
    ]
  }
}
