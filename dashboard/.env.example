# Dashboard environment variables
# Copy to dashboard/.env.local and fill in real values locally. Never commit it.
# Variable names are provisional until the Next.js app is scaffolded (Phase 5).

# --- Public (exposed to the browser; protected by Supabase RLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Server-only (never prefix with NEXT_PUBLIC_) ---
# Used by server routes to mint LiveKit tokens for browser voice sessions.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
