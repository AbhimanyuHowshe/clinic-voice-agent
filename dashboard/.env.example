# Web app environment variables (patient voice page + staff dashboard)
# Locally: dashboard/.env.local (never commit it). On Vercel: Project Settings -> Environment Variables.

# --- Public (sent to the browser; safe because every query is restricted by Supabase RLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# --- Server-only (never prefix with NEXT_PUBLIC_) ---
# Used by /api/token to mint LiveKit tokens for browser voice sessions.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
